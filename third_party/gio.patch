+// forceForeground brings hwnd to the front even when the process was not started by
+// the user's last input: a synthetic Alt press lifts the foreground lock.
+func forceForeground(hwnd syscall.Handle) {
+	keybd := syscall.NewLazyDLL("user32.dll").NewProc("keybd_event")
+	keybd.Call(uintptr(windows.VK_MENU), 0, 0, 0)
+	windows.SetForegroundWindow(hwnd)
+	keybd.Call(uintptr(windows.VK_MENU), 0, 2, 0) // KEYEVENTF_KEYUP
