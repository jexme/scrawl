+// FullscreenAt sets the Fullscreen mode on the monitor whose top-left corner
+// is at (x, y) in the compositor's coordinate space. It is supported on
+// Wayland and X11; other platforms behave like Fullscreen.
+func FullscreenAt(x, y int) Option {
+	return func(_ unit.Metric, cnf *Config) {
+		cnf.Mode = Fullscreen
+		cnf.OutputPos = &image.Point{X: x, Y: y}
+	}
+}
