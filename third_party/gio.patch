+// latinKeysym returns the Latin keysym (a letter, a digit or ASCII punctuation) that the
+// physical key kc produces in the first layout of the keymap that has one.
+func (x *Context) latinKeysym(kc C.xkb_keycode_t) (C.xkb_keysym_t, bool) {
+	layouts := C.xkb_keymap_num_layouts_for_key(x.keyMap, kc)
+	for l := C.xkb_layout_index_t(0); l < layouts; l++ {
+		var syms *C.xkb_keysym_t
+		if C.xkb_keymap_key_get_syms_by_level(x.keyMap, kc, l, 0, &syms) < 1 {
+			continue
+		}
+		if s := *syms; ' ' < s && s <= '~' {
+			return s, true
+		}
+	}
+	// No layout with Latin letters at all (for example only "ru"): fall back to the position
+	// of the key on a QWERTY keyboard. Keycodes here are evdev codes plus 8.
+	if r, ok := qwertyKeys[kc]; ok {
+		return C.xkb_keysym_t(r), true
+	}
+	return 0, false
+}
+
+// qwertyKeys maps the xkb keycodes of the letter and digit keys to what a US keyboard has on them.
+var qwertyKeys = func() map[C.xkb_keycode_t]rune {
+	m := make(map[C.xkb_keycode_t]rune)
+	for i, r := range "qwertyuiop" {
+		m[C.xkb_keycode_t(24+i)] = r
+	}
+	for i, r := range "asdfghjkl" {
+		m[C.xkb_keycode_t(38+i)] = r
+	}
+	for i, r := range "zxcvbnm" {
+		m[C.xkb_keycode_t(52+i)] = r
+	}
+	for i, r := range "1234567890" {
+		m[C.xkb_keycode_t(10+i)] = r
+	}
+	return m
+}()
