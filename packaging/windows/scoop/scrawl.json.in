{
    "version": "@VERSION@",
    "description": "Fast screenshots with annotations: select an area, draw arrows, boxes and text, blur private data",
    "homepage": "https://github.com/jexme/scrawl",
    "license": "MIT",
    "url": "https://github.com/jexme/scrawl/releases/download/v@VERSION@/scrawl-v@VERSION@-windows-amd64.zip",
    "hash": "@HASH@",
    "extract_dir": "scrawl-v@VERSION@-windows-amd64",
    "bin": "scrawl.exe",
    "shortcuts": [
        ["scrawl.exe", "Scrawl", "-tray"]
    ],
    "notes": [
        "Scrawl lives in the notification area: start it from the Start menu (Scrawl) or run 'scrawl'. Press Print to take a screenshot.",
        "Settings: scrawl -settings. Another program may hold Print (Greenshot, Snipping Tool): pick another key in the settings.",
        "Before updating, quit the running Scrawl from its tray icon menu, otherwise the old version keeps serving the hotkey."
    ],
    "checkver": {
        "url": "https://api.github.com/repos/jexme/scrawl/releases",
        "jsonpath": "$[0].tag_name",
        "regex": "v(.+)"
    },
    "autoupdate": {
        "url": "https://github.com/jexme/scrawl/releases/download/v$version/scrawl-v$version-windows-amd64.zip",
        "extract_dir": "scrawl-v$version-windows-amd64",
        "hash": {
            "url": "$url.sha256"
        }
    }
}
