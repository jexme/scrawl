#!/bin/sh
# Before pushing, checks the author and committer addresses in commits that are not yet on
# the server. This way a personal email will not get into the history, even if the commit
# was made bypassing pre-commit (for example, with --no-verify or another client).
allowed='(@users\.noreply\.github\.com|^noreply@github\.com)$'
zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue # branch deletion
	if [ "$remote_sha" = "$zero" ]; then
		range="$local_sha --not --remotes=$1"
	else
		range="$remote_sha..$local_sha"
	fi
	# shellcheck disable=SC2086
	bad=$(git log --format='%h %ae %ce' $range | ALLOWED="$allowed" awk '$2 !~ ENVIRON["ALLOWED"] || $3 !~ ENVIRON["ALLOWED"]')
	if [ -n "$bad" ]; then
		echo "Отправка остановлена: в коммитах не noreply-адрес. / Push stopped: commits with a non-noreply address:" >&2
		echo "$bad" >&2
		echo "Переписать автора / Rewrite the author: scripts/clean-history.sh (see CONTRIBUTING.md)" >&2
		exit 1
	fi
done
